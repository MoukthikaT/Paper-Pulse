# PaperPulse Backend - Environment Variables Template

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# MongoDB Connection URI (Replica Set recommended for native multi-document transactions in production)
MONGODB_URI=mongodb://127.0.0.1:27017/paper_pulse

# JSON Web Token Secret (REQUIRED: Generate a 64+ char random string for production)
JWT_SECRET=your_strong_random_jwt_secret_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# Initial Virtual Cash allocated to newly registered simulator accounts (INR)
INITIAL_WALLET_BALANCE=100000

# Allowed CORS Origins (comma-separated list for production, e.g., https://paperpulse.yourdomain.com)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Demo Trader Account Auto-Seeding ('true' for local dev/demo, 'false' or omitted for production)
SEED_DEMO_USER=false

# Python ML Microservice Configuration
ML_SERVICE_URL=http://127.0.0.1:8000
ML_PYTHON_PATH=python
ML_MODEL_PATH=ml/models/trained
